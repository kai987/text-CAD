.venv/
.tools/
tmp/
__pycache__/
.DS_Store
*.py[cod]
*.log
.env
.env.*
!.env.example

# Downloaded drafting-standard input stays local; keep its provenance.
references/*.pdf
references/*.txt

# Publish the current drawings and model previews, not old plan snapshots.
output/review/*.png
!output/review/jp_floor_plan-*.png
!output/review/house_1f_cad_dark.png
!output/review/house_2f_cad.png
!output/review/house_3d_*.png
!output/review/apartment_2ldk_*.png

# Static viewer dependencies and generated copies.
web/node_modules/
web/dist/
web/public/artifacts/
web/src/house-data.json
web/src/apartment-data.json
web/src/apartment-preview-metadata.json

# Optional native Rust geometry checks are built for the local Python ABI.
/rust/spatial-core/target/
/src/lib/_spatial_native*.so
/src/lib/_spatial_native*.pyd
/src/lib/_spatial_native*.dylib
/src/lib/_spatial_native.manifest.json
/src/lib/_spatial_native*.tmp

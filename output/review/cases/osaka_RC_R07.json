    "review_items": [
      {
        "id": "osaka_fire",
        "text": {
          "zh": "核查防火／准防火地域和市条例对部分用途地域追加的防火要求。",
          "ja": "防火・準防火地域と、用途地域の一部に市条例が追加する防火要件を確認する。",
          "en": "Check fire/quasi-fire designations and city-ordinance fire requirements added to selected zoning districts."
        },
        "source_ids": [
          "osaka-city-fire"
        ]
      },
      {
        "id": "osaka_attic",
        "text": {
          "zh": "2026市取扱1-18禁止阁楼物置作为居室；非loft开口、防火被覆及接合处需核定，其余条件按市引用问答及咨询确认。",
          "ja": "2026年市取扱い1-18では小屋裏物置の居室利用を認めない。非ロフトの開口、防火被覆と取合いを確認し、他の条件は市が引用する質疑集と相談で確認する。",
          "en": "Osaka 2026 interpretation 1-18 prohibits habitable use of attic storage. Review non-loft openings, fire coverings and junctions, and confirm other conditions through referenced guidance and consultation."
        },
        "source_ids": [
          "osaka-city-attic",
          "osaka-city-handling-current"
        ]
      },
      {
        "id": "osaka_snow",
        "text": {
          "zh": "使用市细则的210mm参考条件；不能把大阪府其他市町村的积雪公式或30cm惯例当作大阪市基准。",
          "ja": "市細則の210mmを参考条件として記録。府内の他自治体の積雪式や30cmの慣例を市基準としない。",
          "en": "Record the city rule's 210mm reference; snow formulas or customary 30cm values from other Osaka municipalities are not city rules."
        },
        "source_ids": [
          "osaka-city-snow-rule"
        ]
      }
    ],

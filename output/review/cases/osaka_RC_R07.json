  "national_regulatory_requirements": [
    {
      "id": "new_confirmation_scope",
      "text": {
        "zh": "2025-04-01起，结构无关的两层以上或延床面积>200㎡建筑原则上须建筑确认；本两层住宅需结构审查资料。",
        "ja": "2025年4月1日から構造にかかわらず階数2以上又は延べ200㎡超は原則確認対象。本2階住宅は構造審査資料が必要。",
        "en": "From 2025-04-01, buildings with two or more storeys or over 200m² generally require confirmation regardless of structure; this two-storey house needs structural review documentation."
      },
      "source_ids": [
        "mlit-confirmation-2025"
      ]
    },
    {
      "id": "current_timber_rules",
      "text": {
        "zh": "木造壁量与柱小径按实际建筑重量等核定；旧基准过渡措施2026-03结束，2026-04-01以后开工不能直接沿用。",
        "ja": "木造の壁量・柱小径は建物の重量等で確認。旧基準の経過措置は2026年3月に終了し、4月1日以降着工にそのまま適用できない。",
        "en": "Timber wall quantity and column size require actual building-weight inputs. Old-rule transition ended in March 2026 and cannot simply be applied to starts from 2026-04-01."
      },
      "source_ids": [
        "mlit-timber-current",
        "mlit-timber-transition-2026"
      ]
    },
    {
      "id": "energy_obligation",
      "text": {
        "zh": "2025年4月起原則全部新建住宅须省能源基准适合；结构恒载应包含实际围护及设备。",
        "ja": "2025年4月から原則全ての新築住宅に省エネ基準適合が必要。実際の外皮・設備を構造固定荷重に含める。",
        "en": "New homes generally require energy-standard compliance from April 2025; structural dead loads must include the actual envelope and equipment."
      },
      "source_ids": [
        "mlit-energy-2025"
      ]
    },
    {
      "id": "structural_design_basis",
      "text": {
        "zh": "结构、基础、材料、荷载组合与计算路线须按实际项目和现行法令告示设计；几何检查不等于承载结果。",
        "ja": "構造・基礎・材料・荷重組合せと計算ルートは実計画と現行法令告示で設計する。幾何チェックは耐力結果ではない。",
        "en": "Design structure, foundation, materials, load combinations and calculation route for the actual project under current legislation; geometry checks do not establish capacity."
      },
      "source_ids": [
        "egov-building-law",
        "egov-building-order"
      ]
    }
  ],

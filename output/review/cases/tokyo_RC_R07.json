    "review_items": [
      {
        "id": "tokyo_authority",
        "text": {
          "zh": "东京未定区市町村；应先确定建筑确认及结构审查的实际所管。",
          "ja": "東京の区市町村は未定。確認・構造審査の実際の所管を先に確定する。",
          "en": "The Tokyo ward/city is unresolved; first identify the authority for confirmation and structural review."
        },
        "source_ids": [
          "tokyo-jurisdiction"
        ]
      },
      {
        "id": "tokyo_fire",
        "text": {
          "zh": "除普通防火／准防火地域外，核查东京都追加防火指定及外墙、开口、屋顶构造。",
          "ja": "防火・準防火地域に加え、都の追加防火指定と外壁・開口・屋根仕様を確認する。",
          "en": "Check Tokyo additional fire designations alongside normal fire zones and envelope/opening/roof requirements."
        },
        "source_ids": [
          "tokyo-additional-fire",
          "tokyo-jurisdiction"
        ]
      },
      {
        "id": "tokyo_attic",
        "text": {
          "zh": "江户川区2026参考例核查储物余剰空间、≤1.4m、面积<1/2、楼梯面积、防坠及禁止固定收纳造作等；实际区市认定待确认，1350mm天花不自动获准。",
          "ja": "江戸川区2026年の参考例では収納用の余剰空間、1.4m以下、面積1/2未満、階段面積、転落防止、収納の造作禁止等を確認する。実際の自治体判断は未定で、1350mm天井で自動的に認められない。",
          "en": "An Edogawa 2026 example addresses storage residual space, ≤1.4m, area <1/2, stair area, fall protection and restrictions including built-in storage. Actual local determination is pending; a 1350mm ceiling is not automatic approval."
        },
        "source_ids": [
          "edogawa-attic-reference"
        ]
      }
    ],
